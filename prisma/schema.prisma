// ================================
// PONTOFACIL - SCHEMA DO BANCO DE DADOS
// Multi-tenant com Row-Level Security
// ================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime (ex.: pooler Supabase :6543 + ?pgbouncer=true). Migrações usam directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- EMPRESAS (TENANTS) ----
model Tenant {
  id             String   @id @default(uuid())
  razaoSocial    String
  nomeFantasia   String
  cnpj           String   @unique
  email          String
  telefone       String?
  plano          Plano    @default(BASICO)
  status         StatusTenant @default(ATIVO)

  // Canais de registro (por empresa)
  permitirTotem    Boolean @default(true)
  permitirMeuPonto Boolean @default(true)

  // Geofencing
  geofenceLat    Float?
  geofenceLng    Float?
  geofenceRaio   Int      @default(200) // metros

  // Configurações
  fotoObrigatoria Boolean @default(true)
  geofenceAtivo   Boolean @default(false)
  toleranciaMinutos Int   @default(5)
  /// Aviso/validação de "registro cedo demais" (minutos)
  trabalhoMinimoAntesSaidaMinutos Int @default(30)
  intervaloMinimoAlmocoMinutos    Int @default(30)

  /// Vigência do contrato SaaS (TTL de acesso). Null = sem limite (legado/produção).
  periodoContrato   PeriodoContratoTenant?
  contractStartDate DateTime?
  contractEndDate   DateTime? // calculado automaticamente a partir do período

  /// REP-P: sequência de marcação (2 ou 4 batidas por dia)
  modoMarcacao   ModoMarcacao @default(QUATRO_BATIDAS)
  /// Próximo NSR a atribuir (contador atômico por estabelecimento/CNPJ)
  proximoNsr     Int          @default(1)
  /// Quando true, registros não podem ser excluídos (soft-delete bloqueado)
  modoInviolavel Boolean      @default(false)
  /// Exige CPF ou PIS no colaborador para registrar ponto
  exigirCpfPis   Boolean      @default(true)

  /// Plano comercial cadastrado pelo Super Admin (valor + limite de colaboradores)
  planoComercialId String?
  planoComercial   PlanoComercial? @relation(fields: [planoComercialId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pagamentosPlano PagamentoPlano[]
  auditoriaEventos AuditoriaEvento[]
  features       TenantFeature?
  folhaConfig    FolhaConfig?
  folhaRuns      FolhaRun[]

  usuarios       Usuario[]
  registros      RegistroPonto[]
  escalas        Escala[]
  ajustes        AjustePonto[]
  solicitacoesAjustePonto SolicitacaoAjustePonto[]
  locaisRegistro LocalRegistro[]
  comprovantesAusencia ComprovanteAusencia[]
  feriados       Feriado[]
  ferias         Ferias[]
  espelhoFechamentos EspelhoFechamento[] @relation("EspelhoFechamentoTenant")

  @@map("tenants")
}

// ---- LOCAIS DE REGISTRO (múltiplas cercas por empresa) ----
model LocalRegistro {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome       String
  latitude   Float
  longitude  Float
  raioMetros Int      @default(200)
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  usuariosVinculados Usuario[]

  @@index([tenantId])
  @@map("locais_registro")
}

enum Plano {
  BASICO      // até 10 usuários
  PROFISSIONAL // até 50 usuários
  ENTERPRISE  // ilimitado
}

enum StatusTenant {
  ATIVO
  SUSPENSO
  CANCELADO
}

enum PeriodoContratoTenant {
  MENSAL
  SEMESTRAL
  ANUAL
}

// ---- PLANOS COMERCIAIS (catálogo SaaS) ----
model PlanoComercial {
  id               String   @id @default(uuid())
  nome             String
  descricao        String?
  /// Valor mensal em centavos (ex.: R$ 99,00 = 9900)
  valorCentavos    Int
  /// Limite de colaboradores ativos; null = ilimitado
  maxColaboradores Int?
  ativo            Boolean  @default(true)
  ordem            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenants    Tenant[]
  pagamentos PagamentoPlano[]

  @@map("planos_comerciais")
}

enum StatusPagamentoPlano {
  PENDENTE
  PAGO
  CANCELADO
  EXPIRADO
}

model PagamentoPlano {
  id               String               @id @default(uuid())
  tenantId         String
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planoComercialId String
  planoComercial   PlanoComercial       @relation(fields: [planoComercialId], references: [id], onDelete: Restrict)
  orderNsu         String               @unique
  invoiceSlug      String?
  transactionNsu   String?
  status           StatusPagamentoPlano @default(PENDENTE)
  valorCentavos    Int
  checkoutUrl      String?
  receiptUrl       String?
  captureMethod    String?
  paidAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("pagamentos_plano")
}

enum ModoMarcacao {
  QUATRO_BATIDAS
  DUAS_BATIDAS
}

// ---- USUÁRIOS ----
model Usuario {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nome        String
  email       String
  pinHash     String   // PIN numérico hasheado (usado no totem)
  /// Senha de login web (painel / meu ponto). Se null, o login web aceita o PIN via pinHash (compatibilidade).
  senhaHash   String?
  pinEncrypted String? // PIN criptografado (reversível) para exibição por ADMIN/SUPER_ADMIN
  passwordResetToken   String?
  passwordResetExpires DateTime?
  cargo       String?
  departamento String?
  role        Role     @default(COLABORADOR)
  ativo       Boolean  @default(true)
  fotoPerfil  String?

  /// Dados de vínculo (admissão/demissão). Usado para calcular dias aplicáveis no espelho.
  dataAdmissao DateTime?
  dataDemissao DateTime?

  /// Assinatura padrão do colaborador (capturada uma única vez e reaproveitada nos próximos meses).
  /// Armazena como dataURL PNG. O vetor de traços permite re-renderizar a assinatura.
  assinaturaPadraoDataUrl String? @db.Text
  assinaturaPadraoStrokes Json?
  assinaturaPadraoAtualizadaEm DateTime?

  /// Se preenchido, o colaborador só pode registrar dentro deste local (dentre os ativos do tenant).
  localRegistroId String?
  localRegistro   LocalRegistro? @relation(fields: [localRegistroId], references: [id], onDelete: SetNull)

  /// Se true, o colaborador pode bater ponto de qualquer lugar (sem validar cerca virtual).
  isentoGeofence Boolean @default(false)

  /// Dados para folha de pagamento
  cpf                  String?
  pis                  String?
  matricula            String?
  tipoContrato         TipoContrato @default(CLT)
  salarioBase          Decimal?     @db.Decimal(12, 2)
  categoriaProfissional String?
  dependentesIrrf      Int          @default(0)
  contaBanco           String?
  contaAgencia         String?
  contaNumero          String?
  contaTipo            TipoContaBancaria?

  /// LGPD / Portaria 671: consentimento para geolocalização e foto
  consentimentoDadosEm      DateTime?
  consentimentoDadosVersao  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holerites   Holerite[]
  folhaRunsFechados FolhaRun[] @relation("FolhaRunFechadaPor")

  registros   RegistroPonto[]
  escalas     Escala[]
  ajustesFeitos AjustePonto[] @relation("AdminAjuste")
  solicitacoesAjustePonto SolicitacaoAjustePonto[]
  solicitacoesAjusteRespondidas SolicitacaoAjustePonto[] @relation("SolicitacaoRespondidaAdmin")
  comprovantesAusencia ComprovanteAusencia[]
  comprovantesRespondidos ComprovanteAusencia[] @relation("ComprovanteRespostaAdmin")

  registrosExcluidos RegistroPonto[] @relation("RegistroPontoExcluidoPor")

  ferias Ferias[]
  espelhoFechamentosColaborador EspelhoFechamento[] @relation("EspelhoFechamentoColaborador")
  espelhoFechamentosSolicitados  EspelhoFechamento[] @relation("EspelhoFechamentoSolicitadoPor")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([passwordResetToken])
  @@map("usuarios")
}

enum Role {
  SUPER_ADMIN
  ADMIN       // Gerente da empresa
  COLABORADOR
}

enum TipoContrato {
  CLT
  ESTAGIO
  PJ
}

enum TipoContaBancaria {
  CORRENTE
  POUPANCA
}

enum ModoBancoHoras {
  COMPENSAR
  PAGAR
}

enum StatusFolhaRun {
  RASCUNHO
  CALCULADA
  FECHADA
  PAGA
}

// ---- FEATURE FLAGS POR TENANT ----
model TenantFeature {
  tenantId             String   @id
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollModuleEnabled Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("tenant_features")
}

// ---- CONFIGURAÇÃO DE FOLHA POR EMPRESA ----
model FolhaConfig {
  tenantId                  String         @id
  tenant                    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modoBancoHoras            ModoBancoHoras @default(COMPENSAR)
  heDiaUtilPercent          Int            @default(50)
  heDomingoFeriadoPercent   Int            @default(100)
  adicionalNoturnoPercent   Int            @default(20)
  toleranciaAtrasoMin       Int?
  pagarDSR                  Boolean        @default(true)
  permitirFolhaSemAssinatura Boolean       @default(false)
  tabelasVersao             String?
  tabelasSnapshot           Json?
  /// Dados bancários da empresa (CNAB)
  bancoCodigo               String?
  bancoAgencia              String?
  bancoConta                String?
  bancoConvenio             String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@map("folha_config")
}

// ---- EXECUÇÃO MENSAL DE FOLHA ----
model FolhaRun {
  id                     String         @id @default(uuid())
  tenantId               String
  tenant                 Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mes                    Int
  ano                    Int
  status                 StatusFolhaRun @default(RASCUNHO)
  calculadaEm            DateTime?
  fechadaEm              DateTime?
  fechadaPorId           String?
  fechadaPor             Usuario?       @relation("FolhaRunFechadaPor", fields: [fechadaPorId], references: [id], onDelete: SetNull)
  bloqueadaPorPendencias Json?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  holerites              Holerite[]

  @@unique([tenantId, mes, ano])
  @@index([tenantId, mes, ano])
  @@map("folha_runs")
}

// ---- HOLERITE POR COLABORADOR ----
model Holerite {
  id          String   @id @default(uuid())
  folhaRunId  String
  folhaRun    FolhaRun @relation(fields: [folhaRunId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proventos   Json
  descontos   Json
  bases       Json
  liquido     Decimal  @db.Decimal(12, 2)
  pdfKey      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([folhaRunId, usuarioId])
  @@index([folhaRunId])
  @@index([usuarioId])
  @@map("holerites")
}

// ---- REGISTROS DE PONTO ----
model RegistroPonto {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  tipo        TipoPonto
  dataHora    DateTime @default(now())
  /// Horário UTC no servidor no momento do registro (REP-P)
  dataHoraUtc DateTime?
  /// Número Sequencial de Registro por tenant (Portaria 671)
  nsr         Int?

  // Localização
  latitude    Float?
  longitude   Float?
  dentroGeofence Boolean?

  // Foto
  fotoUrl     String?
  fotoKey     String?  // chave no S3

  // Dispositivo
  deviceId    String?
  ipHash      String?
  userAgent   String?

  // Idempotência (Meu Ponto / fila offline): mesma chave não cria duplicata
  clientRequestId String?

  // Status
  validado    Boolean  @default(true)
  origem      OrigemPonto @default(TOTEM)

  createdAt   DateTime @default(now())

  ajuste      AjustePonto?

  // Exclusão (soft-delete) com auditoria
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     Usuario? @relation("RegistroPontoExcluidoPor", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedMotivo String?

  @@index([tenantId, usuarioId])
  @@index([tenantId, dataHora])
  @@unique([tenantId, nsr], map: "registros_ponto_tenant_nsr_unique")
  @@unique([tenantId, usuarioId, clientRequestId], map: "registros_ponto_client_request_unique")
  @@map("registros_ponto")
}

// ---- AUDITORIA APPEND-ONLY (REP-P / fiscalização interna) ----
model AuditoriaEvento {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entidade      String
  entidadeId    String
  acao          String
  payloadAntes  Json?
  payloadDepois Json?
  actorId       String?
  actorRole     String?
  ipHash        String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entidade, entidadeId])
  @@index([tenantId, acao])
  @@map("auditoria_eventos")
}

enum TipoPonto {
  ENTRADA
  SAIDA_ALMOCO
  RETORNO_ALMOCO
  SAIDA
}

enum OrigemPonto {
  TOTEM
  APP_INDIVIDUAL
  ADMIN_MANUAL
}

enum StatusSolicitacaoAjustePonto {
  PENDENTE
  ATENDIDA
  REJEITADA
}

// ---- SOLICITAÇÕES DE AJUSTE (COLABORADOR -> ADMIN/RH) ----
model SolicitacaoAjustePonto {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Dia de referência da pendência (YYYY-MM-DD)
  dia            String
  /// Tipo faltante ou que precisa correção
  tipo           TipoPonto
  /// Sugestão do colaborador (opcional)
  dataHoraSugerida DateTime?
  justificativa  String

  status         StatusSolicitacaoAjustePonto @default(PENDENTE)
  respondidoPorId String?
  respondidoPor   Usuario? @relation("SolicitacaoRespondidaAdmin", fields: [respondidoPorId], references: [id], onDelete: SetNull)
  respondidoEm    DateTime?
  respostaAdmin   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, usuarioId, dia])
  @@index([tenantId, status])
  @@map("solicitacoes_ajuste_ponto")
}

// ---- ESCALAS DE TRABALHO ----
model Escala {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  nome        String
  horaInicio  String   // "08:00"
  horaFim     String   // "17:00"
  /// Horários esperados de saída/retorno do intervalo (opcional; reforça flags no espelho)
  horaSaidaAlmoco   String?
  horaRetornoAlmoco String?
  diasSemana  Int[]    // [1,2,3,4,5] = seg a sex (ISO: seg=1 ... dom=7)

  cargaHorariaDiaria Float @default(8)
  intervaloMinutos   Int   @default(60)

  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, usuarioId])
  @@map("escalas")
}

// ---- AJUSTES DE PONTO (AUDITORIA) ----
model AjustePonto {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registroId    String   @unique
  registro      RegistroPonto @relation(fields: [registroId], references: [id])
  adminId       String
  admin         Usuario  @relation("AdminAjuste", fields: [adminId], references: [id])

  dataHoraOriginal DateTime
  dataHoraNova     DateTime
  motivo           String
  aprovado         Boolean @default(true)

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@map("ajustes_ponto")
}

// ---- COMPROVANTES DE AUSÊNCIA (atestado, declaração, etc.) ----
model ComprovanteAusencia {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Período da falta (YYYY-MM-DD)
  dataReferencia  String
  dataFim         String?
  descricao       String?

  tipoArquivo     String
  arquivoKey      String?
  arquivoUrl      String?
  mimeType        String?
  nomeArquivoOriginal String?

  status          StatusComprovante @default(PENDENTE)
  observacaoAdmin String?
  respondidoPorId String?
  respondidoPor   Usuario? @relation("ComprovanteRespostaAdmin", fields: [respondidoPorId], references: [id], onDelete: SetNull)
  respondidoEm    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([usuarioId])
  @@map("comprovantes_ausencia")
}

enum StatusComprovante {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusEspelhoFechamento {
  /// Gestor pediu conferência/assinatura; ainda sem aceite do colaborador
  AGUARDANDO_ASSINATURA
  /// Colaborador assinou (homologado)
  ASSINADO
}

// ---- FECHAMENTO / ACEITE DO ESPELHO MENSAL (COLABORADOR) ----
model EspelhoFechamento {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation("EspelhoFechamentoTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation("EspelhoFechamentoColaborador", fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Competência do fechamento (mês/ano)
  mes       Int
  ano       Int

  status StatusEspelhoFechamento @default(ASSINADO)

  /// Gestor que solicitou assinatura (quando status = AGUARDANDO_ASSINATURA)
  solicitadoPorId String?
  solicitadoPor   Usuario? @relation("EspelhoFechamentoSolicitadoPor", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  solicitadoEm    DateTime?

  /// Hash do espelho (rows) no momento do aceite (garante integridade)
  espelhoHash String?
  aprovadoEm  DateTime?

  /// Assinatura capturada na tela (opcional). Pode ser um dataURL "data:image/png;base64,..."
  assinaturaDataUrl String? @db.Text
  /// Vetor de traços/pontos (opcional), para re-renderizar sem armazenar imagem
  assinaturaStrokes Json?

  /// Auditoria (não armazena IP em claro)
  ipHash    String?
  userAgent String?
  deviceId  String?

  createdAt DateTime @default(now())

  @@unique([tenantId, usuarioId, mes, ano])
  @@index([tenantId, mes, ano])
  @@index([tenantId, usuarioId])
  @@index([tenantId, status])
  @@map("espelho_fechamentos")
}

// ---- FERIADOS (por empresa) ----
model Feriado {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Dia do feriado no formato YYYY-MM-DD (evita problemas de fuso)
  data      String
  nome      String
  /// Se true, não há expediente/registro esperado no dia (impacta espelho/resumo).
  suspendeExpediente Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, data])
  @@index([tenantId, data])
  @@map("feriados")
}

// ---- FÉRIAS (por colaborador) ----
model Ferias {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Período (YYYY-MM-DD) inclusivo
  dataInicio String
  dataFim    String
  status     StatusFerias @default(PENDENTE)
  observacao String?
  /// Retorno do gestor ao aprovar ou rejeitar solicitação
  respostaAdmin String?
  respondidoEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, usuarioId])
  @@index([tenantId, dataInicio, dataFim])
  @@map("ferias")
}

enum StatusFerias {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

// ---- SUPER ADMIN (separado dos tenants) ----
model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  senhaHash String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  passwordResetToken   String?
  passwordResetExpires DateTime?

  @@index([passwordResetToken])
  @@map("super_admins")
}
