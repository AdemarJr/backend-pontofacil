NODE_ENV=development
PORT=3001

# Rotas /api/check-ip e /api/test-smtp-* (não use em produção)
# ENABLE_DEBUG_ROUTES=1

# --- PostgreSQL (EasyPanel ou local) ---
# Mesma URL para DATABASE_URL e DIRECT_URL quando não houver pooler (PgBouncer).
# Exemplo EasyPanel:
# DATABASE_URL="postgresql://usuario:senha@host:5432/pontos-pyrou?schema=public&sslmode=disable"
# DIRECT_URL="postgresql://usuario:senha@host:5432/pontos-pyrou?schema=public&sslmode=disable"
DATABASE_URL=""
DIRECT_URL=""

# Chave para criptografar PIN reversível (base64 de 32 bytes). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PIN_ENCRYPTION_KEY=""

JWT_SECRET=defina_uma_string_longa_e_aleatoria
JWT_REFRESH_SECRET=outra_string_longa_diferente
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie HttpOnly do refresh token (cross-origin frontend/backend: use none)
# REFRESH_COOKIE_SAME_SITE=none

FRONTEND_URL=http://localhost:3000
CORS_EXTRA_ORIGINS=

# E-mail — Brevo API (Railway) ou SMTP (local/VPS)
# Brevo API: MAIL_PROVIDER=brevo-api + BREVO_API_KEY (xkeysib- em SMTP & API → API Keys)
MAIL_PROVIDER=brevo-api
BREVO_API_KEY=
MAIL_FROM=
SEND_PIN_IN_EMAIL=false
# SMTP_VERIFY_ON_START=1

# SMTP alternativo (Hostinger / Brevo relay — evite no Railway)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

AWS_S3_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=pontofacil-fotos

# InfinitePay Checkout (https://www.infinitepay.io/checkout-documentacao)
INFINITEPAY_HANDLE=
# API_PUBLIC_URL=https://seu-backend.up.railway.app
